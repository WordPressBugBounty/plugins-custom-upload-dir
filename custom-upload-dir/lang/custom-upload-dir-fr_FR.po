#: custom_upload_dir.php:47
msgid "Custom Upload Dir Settings"
msgstr "Paramètres de Custom Upload Dir"

#: custom_upload_dir.php:78
msgid "Settings"
msgstr "Paramètres"

#: custom_upload_dir.php:462
msgid "Custom Upload Dir: use a relative directory without a drive, URL, control characters, or . and .. segments."
msgstr "Custom Upload Dir : utilisez un chemin relatif sans lecteur, URL, caractères de contrôle ni segments « . » ou « .. »."

#: custom_upload_dir.php:884
msgid "Settings were not saved: expected a settings array."
msgstr "Les paramètres n’ont pas été enregistrés : le format des données est incorrect."

#: custom_upload_dir.php:890
msgid "Settings were not saved: use a path inside the upload folder, without a drive, URL, control characters, or . and .. segments."
msgstr "Les paramètres n’ont pas été enregistrés : utilisez un chemin à l’intérieur du dossier de téléversement, sans lecteur, URL, caractères de contrôle ni segments « . » ou « .. »."

#: custom_upload_dir.php:897 custom_upload_dir.php:903
#: custom_upload_dir.php:911
msgid "Settings were not saved: an upload rule was invalid."
msgstr "Les paramètres n’ont pas été enregistrés : une règle de téléversement est invalide."

#: custom_upload_dir.php:917
msgid "Settings were not saved: a checkbox value was invalid."
msgstr "Les paramètres n’ont pas été enregistrés : la valeur d’une case à cocher est incorrecte."

#: custom_upload_dir.php:941 custom_upload_dir.php:1075
msgid "Routing"
msgstr "Destination"

#: custom_upload_dir.php:947 custom_upload_dir.php:961
msgid "Custom template"
msgstr "Modèle personnalisé"

#: custom_upload_dir.php:960
msgid "Use default"
msgstr "Utiliser le modèle par défaut"

#: custom_upload_dir.php:962
msgid "Leave to WordPress"
msgstr "Laisser WordPress décider"

#: custom_upload_dir.php:969
msgid "You do not have permission to manage these settings."
msgstr "Vous n’avez pas l’autorisation de modifier ces paramètres."

#: custom_upload_dir.php:973
msgid "The file MIME type (for example image/jpeg)"
msgstr "Le type MIME du fichier (par exemple image/jpeg)"

#: custom_upload_dir.php:974
msgid "The file extension"
msgstr "L’extension du fichier"

#: custom_upload_dir.php:975
msgid "The post ID"
msgstr "L’ID de la publication"

#: custom_upload_dir.php:976
msgid "The post author"
msgstr "L’auteur de la publication"

#: custom_upload_dir.php:977
msgid "The post author's numeric ID"
msgstr "L’ID numérique de l’auteur de la publication"

#: custom_upload_dir.php:978
msgid "The post author's role"
msgstr "Le rôle de l’auteur de la publication"

#: custom_upload_dir.php:979
msgid "The post's URL slug"
msgstr "Le slug de la publication (son nom dans l’URL)"

#: custom_upload_dir.php:980
msgid "The parent URL slug"
msgstr "Le slug du parent (son nom dans l’URL)"

#: custom_upload_dir.php:981
msgid "The post type"
msgstr "Le type de publication"

#: custom_upload_dir.php:982
msgid "The post's year (YYYY)"
msgstr "L’année de la publication (AAAA)"

#: custom_upload_dir.php:983
msgid "The post's month (MM)"
msgstr "Le mois de la publication (MM)"

#: custom_upload_dir.php:984
msgid "The post's day (DD)"
msgstr "Le jour de la publication (JJ)"

#: custom_upload_dir.php:985
msgid "The upload year in the site timezone (YYYY)"
msgstr "L’année du téléversement dans le fuseau horaire du site (AAAA)"

#: custom_upload_dir.php:986
msgid "The upload month in the site timezone (MM)"
msgstr "Le mois du téléversement dans le fuseau horaire du site (MM)"

#: custom_upload_dir.php:987
msgid "The upload day in the site timezone (DD)"
msgstr "Le jour du téléversement dans le fuseau horaire du site (JJ)"

#: custom_upload_dir.php:988
msgid "The hour (HH)"
msgstr "L’heure (HH)"

#: custom_upload_dir.php:989
msgid "The minute (MM)"
msgstr "La minute (MM)"

#: custom_upload_dir.php:990
msgid "The second (SS)"
msgstr "La seconde (SS)"

#: custom_upload_dir.php:991
msgid "The currently logged in user"
msgstr "L’utilisateur actuellement connecté"

#: custom_upload_dir.php:992
msgid "The uploader's numeric ID"
msgstr "L’ID numérique de la personne qui téléverse le fichier"

#: custom_upload_dir.php:993
msgid "The post's categories (see: Taxonomies)"
msgstr "Les catégories de la publication (voir les paramètres des taxonomies)"

#: custom_upload_dir.php:994
msgid "The post's tags (see: Taxonomies)"
msgstr "Les étiquettes de la publication (voir les paramètres des taxonomies)"

#: custom_upload_dir.php:997
msgid "Always get all parents"
msgstr "Toujours inclure tous les niveaux parents"

#: custom_upload_dir.php:998
msgid "Flat filesystem (no subfolders for children)"
msgstr "Arborescence à un seul niveau (sans sous-dossiers pour les enfants)"

#: custom_upload_dir.php:999
msgid "Ignore parents (use only leaf nodes)"
msgstr "Ignorer les parents (utiliser uniquement les termes sans enfants)"

#: custom_upload_dir.php:1000
msgid "Ignore children (use only the root of hierarchy)"
msgstr "Ignorer les enfants (utiliser uniquement la racine de la hiérarchie)"

#: custom_upload_dir.php:1005
msgid "Choose where new uploads are stored. Existing files and their URLs are not moved or renamed."
msgstr "Choisissez où enregistrer les nouveaux fichiers téléversés. Les fichiers existants ne sont ni déplacés ni renommés, et leurs URL restent inchangées."

#: custom_upload_dir.php:1010
msgid "Build a path template:"
msgstr "Créez un modèle de chemin :"

#: custom_upload_dir.php:1013
msgid "Separate folders with /. This is the default template. An empty template uses the upload base folder. Token buttons add to the last template field you focused."
msgstr "Séparez les dossiers par /. Ceci est le modèle par défaut. Un modèle vide utilise le dossier de base des téléversements. Les boutons de variables insèrent leur contenu dans le dernier champ de modèle sélectionné."

#: custom_upload_dir.php:1014
msgid "Include /%year%/%monthnum%/ if you want dated folders. Saving here does not change the WordPress Media settings or automatically add date folders."
msgstr "Ajoutez /%year%/%monthnum%/ pour obtenir des dossiers par date. L’enregistrement de ces paramètres ne modifie pas les réglages des médias de WordPress et n’ajoute pas automatiquement de dossiers par date."

#: custom_upload_dir.php:1020
msgid "Custom taxonomy names also work as %taxonomy% tokens. Existing date tokens use the post date, falling back to current site-local time without a dated post. The upload_year, upload_month and upload_day tokens always use the upload date in the site timezone."
msgstr "Les noms de taxonomies personnalisées fonctionnent aussi comme variables %taxonomy%. Les variables de date existantes utilisent la date de la publication, ou l’heure locale actuelle du site en l’absence de publication datée. Les variables upload_year, upload_month et upload_day utilisent toujours la date du téléversement dans le fuseau horaire du site."

#: custom_upload_dir.php:1024
msgid "Templates by parent post type"
msgstr "Modèles par type de publication parente"

#: custom_upload_dir.php:1026
msgid "Use default keeps the template above. Custom template uses the field below, including an empty field for the upload base. Leave to WordPress keeps WordPress and other plugins in control of the directory. Rules for temporarily unavailable post types are retained."
msgstr "Utiliser le modèle par défaut conserve le modèle ci-dessus. Modèle personnalisé utilise le champ ci-dessous ; un champ vide désigne le dossier de base des téléversements. Laisser WordPress décider confie le choix du dossier à WordPress et aux autres extensions. Les règles des types de publications temporairement indisponibles sont conservées."

#: custom_upload_dir.php:1042
msgid "Uploads without a parent"
msgstr "Téléversements sans publication parente"

#: custom_upload_dir.php:1044 custom_upload_dir.php:1089
msgid "Unattached upload"
msgstr "Téléversement sans publication associée"

#: custom_upload_dir.php:1045
msgid "Applies to Media Library uploads without a parent and uploads whose parent no longer exists. Use default preserves your existing behavior."
msgstr "S’applique aux téléversements de la médiathèque sans publication parente et à ceux dont la publication parente n’existe plus. Utiliser le modèle par défaut conserve le fonctionnement actuel."

#: custom_upload_dir.php:1049
msgid "Settings for taxonomy hierarchies:"
msgstr "Paramètres des hiérarchies de taxonomies :"

#: custom_upload_dir.php:1055
msgid "For example: /animals/cats, /animals-cats when flattened, /cats for leaves only, or /animals for roots only. Same-level terms are sorted alphabetically. Leaves-only takes precedence over the parent and root options."
msgstr "Par exemple : /animals/cats, /animals-cats sur un seul niveau, /cats pour les termes sans enfants uniquement, ou /animals pour les racines uniquement. Les termes de même niveau sont triés par ordre alphabétique. L’option « Ignorer les parents » est prioritaire sur les options concernant les parents et les racines."

#: custom_upload_dir.php:1059
msgid "Preview post IDs"
msgstr "ID des publications à prévisualiser"

#: custom_upload_dir.php:1060
msgid "Enter comma-separated post IDs, then save to refresh the preview. Previews use the saved template and a sample file named example.jpg; no folders are created."
msgstr "Saisissez les ID des publications séparés par des virgules, puis enregistrez pour actualiser l’aperçu. L’aperçu utilise le modèle enregistré et un fichier fictif nommé example.jpg ; aucun dossier n’est créé."

#: custom_upload_dir.php:1065
msgid "Saved template preview"
msgstr "Aperçu du modèle enregistré"

#. %s: Example upload date and timezone.
#: custom_upload_dir.php:1070
#, php-format
msgid "Example upload time: %s. The uploader is your currently logged-in user."
msgstr "Heure de téléversement utilisée pour l’exemple : %s. La personne qui téléverse est l’utilisateur actuellement connecté."

#: custom_upload_dir.php:1073
msgid "Try to always name and save your post before uploading attachments."
msgstr "Pensez à donner un titre à votre publication et à l’enregistrer avant d’y téléverser des fichiers."

#: custom_upload_dir.php:1075
msgid "Post"
msgstr "Publication"

#: custom_upload_dir.php:1075
msgid "Upload directory"
msgstr "Dossier de téléversement"

#. %d: A post ID entered for preview.
#: custom_upload_dir.php:1094
#, php-format
msgid "Post #%d was not found; showing an unattached upload."
msgstr "La publication n° %d est introuvable ; l’aperçu montre un téléversement sans publication associée."

#: custom_upload_dir.php:1099
msgid "Current WordPress directory example. The upload method, post date and other plugins may change it; Custom Upload Dir does not override it."
msgstr "Exemple de dossier actuel de WordPress. La méthode de téléversement, la date de la publication et d’autres extensions peuvent le modifier ; Custom Upload Dir ne le remplace pas."

#: custom_upload_dir.php
msgid "Custom Upload Dir"
msgstr "Custom Upload Dir"

#: custom_upload_dir.php
msgid "Keeps your uploaded files organized in smart folder structures."
msgstr "Organisez vos fichiers téléversés dans une arborescence de dossiers adaptée à vos besoins."