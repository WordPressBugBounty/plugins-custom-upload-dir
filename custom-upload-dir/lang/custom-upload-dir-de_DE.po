#: custom_upload_dir.php:47
msgid "Custom Upload Dir Settings"
msgstr "Einstellungen für Custom Upload Dir"

#: custom_upload_dir.php:78
msgid "Settings"
msgstr "Einstellungen"

#: custom_upload_dir.php:382
msgid "Custom Upload Dir: use a relative directory without a drive, URL, control characters, or . and .. segments."
msgstr "Custom Upload Dir: Verwende einen relativen Verzeichnispfad ohne Laufwerksangabe, URL, Steuerzeichen oder die Pfadsegmente „.“ und „..“."

#: custom_upload_dir.php:795
msgid "Settings were not saved: expected a settings array."
msgstr "Die Einstellungen wurden nicht gespeichert: Die Daten haben nicht das erwartete Format."

#: custom_upload_dir.php:801
msgid "Settings were not saved: use a path inside the upload folder, without a drive, URL, control characters, or . and .. segments."
msgstr "Die Einstellungen wurden nicht gespeichert: Verwende einen Pfad innerhalb des Upload-Ordners, ohne Laufwerksangabe, URL, Steuerzeichen oder die Pfadsegmente „.“ und „..“."

#: custom_upload_dir.php:808
msgid "Settings were not saved: a checkbox value was invalid."
msgstr "Die Einstellungen wurden nicht gespeichert: Der Wert eines Kontrollkästchens war ungültig."

#: custom_upload_dir.php:823
msgid "You do not have permission to manage these settings."
msgstr "Du bist nicht berechtigt, diese Einstellungen zu verwalten."

#: custom_upload_dir.php:827
msgid "The file MIME type (for example image/jpeg)"
msgstr "Der MIME-Typ der Datei (zum Beispiel image/jpeg)"

#: custom_upload_dir.php:828
msgid "The file extension"
msgstr "Die Dateiendung"

#: custom_upload_dir.php:829
msgid "The post ID"
msgstr "Die Beitrags-ID"

#: custom_upload_dir.php:830
msgid "The post author"
msgstr "Der Autor des Beitrags"

#: custom_upload_dir.php:831
msgid "The post author's role"
msgstr "Die Rolle des Beitragsautors"

#: custom_upload_dir.php:832
msgid "The post's URL slug"
msgstr "Die Titelform des Beitrags (sein Name in der URL)"

#: custom_upload_dir.php:833
msgid "The parent URL slug"
msgstr "Die Titelform des übergeordneten Inhalts"

#: custom_upload_dir.php:834
msgid "The post type"
msgstr "Der Inhaltstyp"

#: custom_upload_dir.php:835
msgid "The post's year (YYYY)"
msgstr "Das Jahr des Beitrags (JJJJ)"

#: custom_upload_dir.php:836
msgid "The post's month (MM)"
msgstr "Der Monat des Beitrags (MM)"

#: custom_upload_dir.php:837
msgid "The post's day (DD)"
msgstr "Der Tag des Beitrags (TT)"

#: custom_upload_dir.php:838
msgid "The hour (HH)"
msgstr "Die Stunde (HH)"

#: custom_upload_dir.php:839
msgid "The minute (MM)"
msgstr "Die Minute (MM)"

#: custom_upload_dir.php:840
msgid "The second (SS)"
msgstr "Die Sekunde (SS)"

#: custom_upload_dir.php:841
msgid "The currently logged in user"
msgstr "Der aktuell angemeldete Benutzer"

#: custom_upload_dir.php:842
msgid "The post's categories (see: Taxonomies)"
msgstr "Die Kategorien des Beitrags (siehe Taxonomie-Einstellungen)"

#: custom_upload_dir.php:843
msgid "The post's tags (see: Taxonomies)"
msgstr "Die Schlagwörter des Beitrags (siehe Taxonomie-Einstellungen)"

#: custom_upload_dir.php:846
msgid "Always get all parents"
msgstr "Immer alle übergeordneten Ebenen einbeziehen"

#: custom_upload_dir.php:847
msgid "Flat filesystem (no subfolders for children)"
msgstr "Flache Ordnerstruktur (keine Unterordner für untergeordnete Begriffe)"

#: custom_upload_dir.php:848
msgid "Ignore parents (use only leaf nodes)"
msgstr "Übergeordnete Ebenen ignorieren (nur Begriffe ohne Unterbegriffe verwenden)"

#: custom_upload_dir.php:849
msgid "Ignore children (use only the root of hierarchy)"
msgstr "Untergeordnete Ebenen ignorieren (nur die oberste Ebene verwenden)"

#: custom_upload_dir.php:854
msgid "Choose where new uploads are stored. Existing files and their URLs are not moved or renamed."
msgstr "Wähle, wo neue Uploads gespeichert werden. Vorhandene Dateien werden weder verschoben noch umbenannt; ihre URLs bleiben unverändert."

#: custom_upload_dir.php:859
msgid "Build a path template:"
msgstr "Pfadvorlage erstellen:"

#: custom_upload_dir.php:862
msgid "Separate folders with /. This template applies to all post types. An empty template uses the upload base folder."
msgstr "Trenne Ordner mit /. Diese Vorlage gilt für alle Inhaltstypen. Bei einer leeren Vorlage wird der Basisordner für Uploads verwendet."

#: custom_upload_dir.php:863
msgid "Include /%year%/%monthnum%/ if you want dated folders. Saving here does not change the WordPress Media settings or automatically add date folders."
msgstr "Füge /%year%/%monthnum%/ ein, wenn du Datumsordner möchtest. Das Speichern hier ändert weder die Medien-Einstellungen von WordPress noch werden automatisch Datumsordner hinzugefügt."

#: custom_upload_dir.php:869
msgid "Custom taxonomy names also work as %taxonomy% tokens. Dates use the post date; uploads without a post use current site-local time and omit post-specific tokens."
msgstr "Namen eigener Taxonomien funktionieren ebenfalls als %taxonomy%-Platzhalter. Für Datumsangaben wird das Beitragsdatum verwendet. Uploads ohne zugeordneten Beitrag verwenden die aktuelle Zeit in der Zeitzone der Website und lassen beitragsbezogene Platzhalter weg."

#: custom_upload_dir.php:873
msgid "Settings for taxonomy hierarchies:"
msgstr "Einstellungen für Taxonomie-Hierarchien:"

#: custom_upload_dir.php:879
msgid "For example: /animals/cats, /animals-cats when flattened, /cats for leaves only, or /animals for roots only. Same-level terms are sorted alphabetically. Leaves-only takes precedence over the parent and root options."
msgstr "Zum Beispiel: /animals/cats, /animals-cats bei flacher Struktur, /cats nur für Begriffe ohne Unterbegriffe oder /animals nur für die oberste Ebene. Begriffe derselben Ebene werden alphabetisch sortiert. Die Option „Übergeordnete Ebenen ignorieren“ hat Vorrang vor den Optionen für übergeordnete und oberste Ebenen."

#: custom_upload_dir.php:883
msgid "Preview post IDs"
msgstr "Beitrags-IDs für die Vorschau"

#: custom_upload_dir.php:884
msgid "Enter comma-separated post IDs, then save to refresh the preview. Previews use the saved template and a sample file named example.jpg; no folders are created."
msgstr "Gib Beitrags-IDs durch Kommas getrennt ein und speichere, um die Vorschau zu aktualisieren. Die Vorschau verwendet die gespeicherte Vorlage und eine Beispieldatei namens example.jpg. Es werden keine Ordner erstellt."

#: custom_upload_dir.php:889
msgid "Saved template preview"
msgstr "Vorschau der gespeicherten Vorlage"

#: custom_upload_dir.php:890
msgid "Try to always name and save your post before uploading attachments."
msgstr "Gib deinem Beitrag möglichst immer einen Titel und speichere ihn, bevor du Dateien dazu hochlädst."

#: custom_upload_dir.php:892
msgid "Post"
msgstr "Beitrag"

#: custom_upload_dir.php:892
msgid "Upload directory"
msgstr "Upload-Verzeichnis"

#: custom_upload_dir.php:904
msgid "Unattached upload"
msgstr "Upload ohne zugeordneten Beitrag"

#. %d: A post ID entered for preview.
#: custom_upload_dir.php:909
#, php-format
msgid "Post #%d was not found; showing an unattached upload."
msgstr "Beitrag #%d wurde nicht gefunden. Die Vorschau zeigt einen Upload ohne zugeordneten Beitrag."

#: custom_upload_dir.php
msgid "Custom Upload Dir"
msgstr "Custom Upload Dir"

#: custom_upload_dir.php
msgid "Keeps your uploaded files organized in smart folder structures."
msgstr "Organisiert hochgeladene Dateien in passenden Ordnerstrukturen."